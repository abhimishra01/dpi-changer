---
// DPI changer. Everything runs in the browser. Byte-level edits live in src/lib/dpi.js.
---
<section id="tool" aria-label="DPI changer" class="rounded-2xl border border-line bg-card p-4 sm:shadow-[6px_6px_0_0_var(--line)] sm:p-6">
  <div id="drop" class="relative flex min-h-40 flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-muted/50 bg-paper px-4 py-8 text-center transition-colors data-[over=true]:border-brand data-[over=true]:bg-brand-soft">
    <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-brand-ink"><path d="M12 16V4m0 0L7 9m5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
    <p class="hidden text-base font-semibold sm:block">Drop JPEG or PNG files here</p>
    <p class="hidden text-sm text-muted sm:block">or</p>
    <input id="file" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" multiple class="peer sr-only" />
    <label for="file" class="inline-flex min-h-11 cursor-pointer items-center rounded-xl bg-brand px-5 text-sm font-semibold text-white hover:opacity-90 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-ink">Choose images</label>
    <p class="text-xs text-muted">Several files at once. Your images never leave your device.</p>
  </div>

  <fieldset class="mt-5">
    <legend class="text-sm font-semibold">Set DPI to</legend>
    <div class="mt-2 flex flex-wrap items-center gap-2" id="presets">
      {[72, 150, 300, 600].map((v) => (
        <button type="button" aria-pressed={v === 300 ? 'true' : 'false'} data-dpi={v}
          class="preset min-h-11 min-w-16 rounded-xl border border-line bg-paper px-4 font-mono text-base font-semibold tabular-nums hover:border-brand aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:text-white">{v}</button>
      ))}
      <label class="ml-1 flex items-center gap-2 text-sm text-muted" for="custom">Custom
        <input id="custom" type="number" aria-describedby="dpi-msg" inputmode="numeric" min="1" max="9999" step="1" placeholder="e.g. 350" autocomplete="off"
          class="min-h-11 w-32 rounded-xl border border-line bg-paper px-3 font-mono text-base text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/30" />
      </label>
    </div>
    <p id="dpi-msg" class="mt-2 hidden text-sm text-red-700 dark:text-red-400" role="alert"></p>
  </fieldset>

  <div class="mt-5 min-h-24">
    <p id="empty" class="rounded-xl bg-brand-soft p-4 text-sm text-muted">No files yet. Pixels stay exactly as they are. Only the DPI value in the file header changes.</p>
    <ul id="list" class="grid grid-cols-[minmax(0,1fr)] gap-3"></ul>
  </div>

  <p id="status" role="status" class="mt-3 min-h-5 text-sm text-muted"></p>

  <div id="actions" class="mt-3 hidden flex-wrap items-center gap-3">
    <button id="zip" type="button" class="min-h-11 rounded-xl bg-brand px-5 text-sm font-semibold text-white hover:opacity-90 disabled:opacity-50">Download all as zip</button>
    <button id="clear" type="button" class="min-h-11 rounded-xl border border-line px-5 text-sm font-semibold hover:border-brand">Clear</button>
  </div>
</section>

<script>
  import { zipSync } from 'fflate';
  import { inspect, setDpi, printSize, outName, uniqueNames, MAX_DPI } from '../lib/dpi.js';

  const DEFAULT_DPI = 300;
  const MAX_TOTAL_BYTES = 500 * 1024 * 1024; // all files together; they are held in memory

  type Item = { name: string; bytes: Uint8Array; info?: ReturnType<typeof inspect>; error?: string };
  const items: Item[] = [];
  let target = DEFAULT_DPI;
  let valid = true; // false while the custom box holds a bad value
  let totalBytes = 0;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const list = $('list'), empty = $('empty'), actions = $('actions'), msg = $('dpi-msg'), status = $('status');
  const custom = $<HTMLInputElement>('custom'), fileInput = $<HTMLInputElement>('file'), drop = $('drop'), zipBtn = $<HTMLButtonElement>('zip');
  const presets = Array.from(document.querySelectorAll<HTMLButtonElement>('.preset'));

  const fmt = (n: number, d = 1) => n.toLocaleString('en-US', { maximumFractionDigits: d });
  const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
  const nameOf = (it: Item) => outName(it.name, target, it.info!.type);

  function save(name: string, data: Uint8Array, type: string) {
    const url = URL.createObjectURL(new Blob([data as BlobPart], { type }));
    const a = document.createElement('a');
    a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 4000);
  }
  const mime = (it: Item) => (it.info?.type === 'png' ? 'image/png' : 'image/jpeg');

  function line(parent: HTMLElement, text: string) {
    const d = document.createElement('span'); d.className = 'block'; d.textContent = text; parent.appendChild(d);
  }

  function row(it: Item) {
    const li = document.createElement('li');
    li.className = 'min-w-0 rounded-xl border border-line bg-paper p-3 sm:flex sm:items-center sm:gap-4';
    const body = document.createElement('div');
    body.className = 'min-w-0 flex-1';
    const name = document.createElement('p');
    name.className = 'truncate text-sm font-semibold'; name.textContent = it.name; name.title = it.name;
    const meta = document.createElement('p');
    meta.className = it.error || !it.info ? 'mt-1 text-sm text-red-700 dark:text-red-400' : 'mt-1 text-sm text-muted';
    body.append(name, meta);
    li.appendChild(body);
    if (it.error || !it.info) { meta.textContent = it.error ?? 'Could not read this file.'; return li; }

    const i = it.info, d = i.dpi;
    const cur = d ? (d.x === d.y ? `${fmt(d.x)} DPI` : `${fmt(d.x)} x ${fmt(d.y)} DPI`) : 'not set';
    const s = printSize(i.width, i.height, target);
    line(meta, `${fmt(i.width, 0)} x ${fmt(i.height, 0)} px, ${i.type.toUpperCase()}`);
    line(meta, `DPI now: ${cur}  →  ${valid ? target : '?'}`);
    if (valid) {
      line(meta, `Print size at ${target} DPI: ${fmt(s.inW, 2)} x ${fmt(s.inH, 2)} in (${fmt(s.cmW)} x ${fmt(s.cmH)} cm)`);
      if (Math.max(s.inW, s.inH) < 10 || Math.min(s.inW, s.inH) < 8) {
        line(meta, `An 8 x 10 in print at ${target} DPI needs ${fmt(8 * target, 0)} x ${fmt(10 * target, 0)} px.`);
      }
    }
    const btn = document.createElement('button');
    btn.type = 'button'; btn.textContent = 'Download'; btn.disabled = !valid;
    btn.setAttribute('aria-label', `Download ${it.name} at ${target} DPI`);
    btn.className = 'mt-3 min-h-11 w-full rounded-xl border border-brand px-4 text-sm font-semibold text-brand-ink hover:bg-brand-soft disabled:opacity-50 sm:mt-0 sm:w-auto';
    btn.addEventListener('click', () => {
      try {
        const n = nameOf(it);
        save(n, setDpi(it.bytes, target), mime(it));
        status.textContent = `Saved as ${n}. Pixels not changed.`;
      } catch (e) { status.textContent = `${it.name}: ${(e as Error).message}`; }
    });
    li.appendChild(btn);
    return li;
  }

  function render() {
    list.replaceChildren(...items.map(row));
    empty.hidden = items.length > 0;
    const ok = items.filter((x) => x.info).length;
    actions.classList.toggle('hidden', items.length === 0);
    actions.classList.toggle('flex', items.length > 0);
    zipBtn.hidden = ok < 2;
    zipBtn.disabled = !valid;
    zipBtn.textContent = `Download all ${ok} as zip`;
    status.textContent = ok > 0 && valid ? `${plural(ok, 'file')} ready at ${target} DPI.` : '';
  }

  function setTarget(v: number, fromCustom = false) {
    valid = Number.isInteger(v) && v >= 1 && v <= MAX_DPI;
    msg.textContent = valid ? '' : `Enter a whole number from 1 to ${MAX_DPI}.`;
    msg.classList.toggle('hidden', valid);
    custom.setAttribute('aria-invalid', String(!valid));
    if (valid) target = v;
    presets.forEach((b) => b.setAttribute('aria-pressed', String(valid && !fromCustom && Number(b.dataset.dpi) === v)));
    render();
  }
  presets.forEach((b) => b.addEventListener('click', () => { custom.value = ''; setTarget(Number(b.dataset.dpi)); }));
  // An empty box means "use the default". Half-typed input such as "3e" counts as invalid, not empty.
  custom.addEventListener('input', () => {
    const raw = custom.value.trim();
    if (raw === '' && !custom.validity.badInput) setTarget(DEFAULT_DPI);
    else setTarget(custom.validity.badInput ? NaN : Number(raw), true);
  });

  async function add(files: FileList | File[]) {
    const first = items.length;
    for (const f of Array.from(files)) {
      const it: Item = { name: f.name, bytes: new Uint8Array(0) };
      if (totalBytes + f.size > MAX_TOTAL_BYTES) it.error = 'Skipped: the files together are over 500 MB. Download this batch first, then add more.';
      else {
        try { it.bytes = new Uint8Array(await f.arrayBuffer()); totalBytes += it.bytes.length; it.info = inspect(it.bytes); }
        catch (e) { it.error = e instanceof Error && it.bytes.length ? e.message : 'Could not read this file.'; }
      }
      items.push(it);
    }
    render();
    const added = list.children[first];
    if (added) added.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }
  fileInput.addEventListener('change', () => { if (fileInput.files) add(fileInput.files); fileInput.value = ''; });
  // A file dropped outside the box must not make the browser open it and lose the batch, so the whole window takes drops.
  ['dragenter', 'dragover'].forEach((t) => window.addEventListener(t, (e) => { e.preventDefault(); drop.dataset.over = 'true'; }));
  window.addEventListener('dragleave', (e) => { if (!(e as DragEvent).relatedTarget) drop.dataset.over = 'false'; });
  window.addEventListener('drop', (e) => {
    e.preventDefault(); drop.dataset.over = 'false';
    const dt = (e as DragEvent).dataTransfer; if (dt?.files?.length) add(dt.files);
  });
  $('clear').addEventListener('click', () => { items.length = 0; totalBytes = 0; render(); });

  zipBtn.addEventListener('click', async () => {
    zipBtn.disabled = true; zipBtn.textContent = 'Working...';
    await new Promise((r) => setTimeout(r, 30)); // let the browser paint the label before the heavy part
    try {
      const good = items.filter((it) => it.info);
      const names = uniqueNames(good.map(nameOf));
      const files: Record<string, Uint8Array> = {};
      const failed: string[] = [];
      good.forEach((it, k) => { try { files[names[k]] = setDpi(it.bytes, target); } catch { failed.push(it.name); } });
      if (Object.keys(files).length === 0) { status.textContent = 'No file could be saved.'; return; }
      save(`images-${target}dpi.zip`, zipSync(files, { level: 0 }), 'application/zip');
      status.textContent = failed.length ? `Saved the zip. Skipped ${plural(failed.length, 'file')}: ${failed.join(', ')}.` : `Saved ${plural(good.length, 'file')} in a zip. Pixels not changed.`;
    } catch (e) { status.textContent = (e as Error).message; }
    finally { zipBtn.disabled = !valid; zipBtn.textContent = `Download all ${items.filter((x) => x.info).length} as zip`; }
  });
  render();
</script>
