---
import { withBase, stripBase } from '../lib/url.ts';
import ThemeToggle from './ThemeToggle.astro';
const path = stripBase(Astro.url.pathname);
const links = [
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact', hideTiny: true }, // the footer has it too
];
---
<header class="sticky top-0 z-20 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4">
    <a href={withBase('/')} class="flex shrink-0 items-center gap-2 font-bold tracking-tight text-ink no-underline">
      <img src={withBase('favicon.svg')} alt="" width="30" height="30" class="h-[30px] w-[30px] rounded-lg" />
      <span class="whitespace-nowrap text-lg leading-none"><span class="font-extrabold">DPI</span> <span class="font-medium text-muted">changer</span></span>
    </a>
    <div class="flex items-center gap-1">
      <nav aria-label="Main" class="flex items-center">
        {links.map((l) => (
          <a href={withBase(l.href)} aria-current={path === l.href ? 'page' : undefined}
            class:list={['rounded-full px-3 py-2 text-sm font-medium text-muted no-underline hover:text-ink aria-[current=page]:text-ink aria-[current=page]:bg-brand-soft', l.hideTiny && 'max-[359px]:hidden']}>{l.label}</a>
        ))}
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
