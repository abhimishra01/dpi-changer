---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import Article from '../components/Article.astro';
import Faq from '../components/Faq.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';

const base = `https://${site.domain}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    applicationCategory: site.category,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    isAccessibleForFree: true,
    featureList: ['Change DPI of JPEG and PNG files', 'No re-encoding, pixels stay the same', 'Several files at once', 'Download as a zip', 'Print size in inches and cm'],
    image: `${base}${site.ogImage}`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd} title="Change Image DPI to 300, Free and Private">
  <section class="mx-auto max-w-5xl px-4 pt-8 sm:pt-10">
    <p class="mb-3 inline-block rounded-full bg-brand-soft px-3 py-1 text-sm font-medium text-brand-ink">{site.tagline}</p>
    <h1 class="max-w-3xl text-4xl font-extrabold leading-[1.05] tracking-tight [text-wrap:balance] sm:text-6xl">
      {site.keyword.charAt(0).toUpperCase() + site.keyword.slice(1)}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">{site.description}</p>
    <div class="mt-8 min-h-[22rem]"><Tool /></div>
  </section>
  <Article />
  <Faq />
</Base>
