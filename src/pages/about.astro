---
import Page from '../layouts/Page.astro';
import site from '../site.config.ts';
import { withBase } from '../lib/url.ts';
---
<Page title="About" description={`About ${site.name}, a free tool that changes the DPI of JPEG and PNG images in your browser.`}>
  <p>{site.name} changes the DPI value of JPEG and PNG images. It is free, and it needs no account.</p>
  <h2>What it is for</h2>
  <p>Print shops and Etsy listings often ask for 300 DPI files. This tool does only the DPI change, and it does it in your browser.</p>
  <h2>How it works</h2>
  <p>A JPEG or PNG file stores its DPI in a small header. The tool rewrites those few bytes and leaves the pixel data as it is. Nothing is decoded or compressed again, so the quality does not change.</p>
  <p>All of it runs in your browser. Your images never leave your device.</p>
  <h2>Contact</h2>
  <p>Questions or ideas? Write to <a href={site.contactHref}>{site.contactLabel}</a> or visit the <a href={withBase('/contact/')}>Contact page</a>.</p>
</Page>
